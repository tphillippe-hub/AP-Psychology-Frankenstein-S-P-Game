    o.connect(lp); lp.connect(g); g.connect(comp); comp.connect(ctx.destination); o.start(t); o.stop(t+dur+.05);
    return dur;
  }
};
function heardCaption(loss,robotic){
  const o=loss.map(v=>Math.max(0,v-BASE)), lo=(o[0]+o[1]+o[2])/3, hi=(o[4]+o[5])/2, avg=o.reduce((a,b)=>a+b,0)/6;
  if(robotic) return "Frank hears a buzzy, robotic version of the sounds. It is understandable, but it is not like natural hearing.";
  if(avg<=10) return "Frank hears clearly: the thunder, the melody, and the high creaks.";
  if(hi-lo>=20) return "Low sounds like the thunder come through, but high pitches, like the creaks and the top notes of the melody, are faint or missing.";
  if(avg<=40) return "Everything sounds quieter, at every pitch.";
  return "Everything is very faint.";
}
