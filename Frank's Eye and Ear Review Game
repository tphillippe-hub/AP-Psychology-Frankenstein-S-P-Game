<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Frank’s Laboratory</title>
<link href="https://fonts.googleapis.com/css2?family=Pirata+One&family=Special+Elite&display=swap" rel="stylesheet">
<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  color-scheme:dark;
  --plum:#2B1A38;
  --plum-lift:#3B2650;
  --paper:#D6DFD1;
  --ink:#1E1426;
  --amber:#F5A524;
  --rust:#B8452F;
  --steel:#8E9AA0;
  --skin:#8FB573;
  --good:#BFE0B0;
  --bad:#F0C2B8;
  --light:#EFE8F5;
  --crt:#0C1A18;
  --crt-ink:#CBEADF;
  --head:"Pirata One","Palatino Linotype",Georgia,serif;
  --body:"Special Elite","Courier New",Courier,monospace;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--plum);color:var(--light);font-family:var(--body);font-size:18px;line-height:1.55;min-height:100vh}
.wrap{max-width:1180px;margin:0 auto;padding:18px 18px 56px}
.bar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px}
.bar h1{font-family:var(--head);font-weight:400;font-size:2.5rem;line-height:1.05;margin:0}
.bar-right{display:flex;gap:8px;flex-wrap:wrap}
.chip{font:inherit;font-size:.9rem;color:var(--light);background:transparent;border:2px solid var(--steel);border-radius:4px;padding:5px 12px;cursor:pointer}
.chip:hover{background:var(--plum-lift)}
button:focus-visible,input:focus-visible,.slot:focus-visible{outline:3px solid var(--amber);outline-offset:3px}
.panel button:focus-visible,.panel input:focus-visible{outline-color:var(--rust)}

.panel{background:var(--paper);color:var(--ink);border:3px dashed var(--ink);outline:6px solid var(--paper);outline-offset:-3px;border-radius:8px;padding:24px 26px 26px}
.panel h2{font-family:var(--head);font-weight:400;font-size:2rem;line-height:1.1;margin:0 0 10px}
.panel p{margin:0 0 14px;max-width:64ch}
.btn{font:inherit;font-size:1.05rem;color:var(--ink);background:var(--amber);border:2px solid var(--ink);border-radius:4px;padding:9px 20px;cursor:pointer}
.btn:hover{background:#FFB93F}
.btn.ghost{background:transparent}
.btn.ghost:hover{background:#E6D9B5}
.btn:disabled{opacity:.5;cursor:default}

/* home */
.home{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.35fr);gap:28px;align-items:start}
label.name{display:block;margin:16px 0 6px}
input.name{font:inherit;width:100%;max-width:340px;padding:9px 12px;border:2px solid var(--ink);border-radius:4px;background:#EEF2EB;color:var(--ink)}
.small{font-size:.9rem;color:#4A3A5A}
.levels{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.level{display:grid;grid-template-columns:54px 1fr;gap:14px;align-items:start;border:2px dashed var(--steel);border-radius:6px;padding:14px 16px}
.level.open{border-color:var(--amber);background:var(--plum-lift)}
.level.locked{opacity:.62}
.ln{font-family:var(--head);font-size:2.6rem;line-height:1;text-align:center}
.level h3{font-family:var(--head);font-weight:400;font-size:1.5rem;line-height:1.15;margin:0 0 4px}
.level p{margin:0 0 10px;font-size:.95rem;color:#D8CDE6}
.badge{display:inline-block;background:var(--good);color:var(--ink);padding:1px 10px;border-radius:3px;font-size:.85rem;margin-left:8px;vertical-align:middle}
.soon{font-size:.9rem;color:#BDB0CC}

/* level shell */
.lvl-head{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:12px}
.lvl-head h2{font-family:var(--head);font-weight:400;font-size:1.9rem;margin:0}
.phase{margin:0;color:#CBBFD8;font-size:.95rem}
.lab{display:grid;grid-template-columns:250px minmax(0,1fr);gap:22px;align-items:start}
.scene{position:sticky;top:12px}
#tablescene{width:100%;height:auto;display:block}
#tbody{filter:saturate(calc(.2 + .8 * var(--vit,0))) brightness(calc(.8 + .2 * var(--vit,0)));transition:filter .6s}
.meter{margin-top:8px}
.meter-label{font-size:.88rem;margin:0 0 6px;color:#CBBFD8}
.stitches{display:flex;gap:3px}
.stitch{flex:1;height:18px;border:2px solid var(--steel);border-radius:2px;transform:skewX(-12deg)}
.stitch.on{background:var(--amber);border-color:var(--amber)}

/* monitor */
.monitor{display:grid;grid-template-columns:minmax(0,1.85fr) minmax(0,1fr);gap:12px;background:#1B1424;border:3px solid #0E0A14;border-radius:18px;padding:12px;margin-bottom:16px}
.screen{position:relative;background:var(--crt);border:2px solid #2D4A44;border-radius:10px;padding:10px 10px 12px;color:var(--crt-ink);min-width:0}
.screen::after{content:"";position:absolute;inset:0;border-radius:8px;background:repeating-linear-gradient(to bottom,rgba(0,0,0,.14) 0 1px,transparent 1px 3px);pointer-events:none}
.screen-title{font-size:.85rem;margin:0 0 6px;color:#8FC5B6}
#eye,#view{width:100%;height:auto;display:block}
#eye text{font-family:var(--body)}
.sl{fill:rgba(245,165,36,.1);stroke:#F5A524;stroke-dasharray:6 5}
.sl.nofill{fill:none}
.slot{cursor:pointer}
.armed .slot .sl{fill:rgba(245,165,36,.24)}
.slot:hover .sl{stroke:#FFD479}
.slot:focus-visible{outline:none}
.slot:focus-visible .sl{stroke:#fff;stroke-width:4}
.rays{pointer-events:none}
.lab-t line{stroke:#9FD3C6;stroke-width:1.5}
.lab-t circle{fill:#9FD3C6}
.lab-t text{fill:#E3F4EE;font-size:17px}
.cl text,.fm{fill:#E3F4EE;font-size:15px;paint-order:stroke;stroke:#0C1A18;stroke-width:4px}
.chain{list-style:none;margin:10px 0 0;padding:0;font-size:.84rem;line-height:1.45}
.chain li.ok{color:#9ED9A7}
.chain li.miss{color:#F0B778}
.verdict{margin:8px 0 0;font-size:.9rem;min-height:4.2em}
.readout{margin:0;font-size:.9rem}

/* bench */
.bench{padding:20px 22px 22px}
.bench-head{display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap}
.bt{font-family:var(--head);font-weight:400;font-size:1.7rem;margin:0 0 6px}
.count{font-size:.95rem}
.help{font-size:.95rem}
.tray{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px;margin:6px 0 12px}
.part{display:grid;grid-template-columns:76px 1fr;gap:10px;align-items:center;text-align:left;font:inherit;color:var(--ink);background:#EEF2EB;border:2px solid var(--ink);border-radius:4px;padding:8px 10px;cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none}
.part:hover:not(:disabled){background:#FBE3B4}
.part.sel{background:#FBE3B4;outline:3px solid var(--rust);outline-offset:1px}
.part.dragging{opacity:.4}
.part:disabled{opacity:.55;cursor:default}
.part .pn{display:block;font-family:var(--head);font-size:1.25rem;line-height:1.1}
.part .pc{display:block;font-size:.8rem;line-height:1.3}
.pico{width:76px;height:60px;display:block;border-radius:3px}
.ghost-drag{position:fixed;left:0;top:0;z-index:60;width:76px;height:60px;pointer-events:none;opacity:.92;filter:drop-shadow(0 4px 6px rgba(0,0,0,.5))}
.shake{animation:shake .35s}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.notice{white-space:pre-line;min-height:3.2em;padding:8px 12px;border-left:5px solid var(--steel);background:#E7EDE3;font-size:.95rem;margin:0 0 12px}
.notice.good{border-color:#4E9A57;background:var(--good)}
.notice.bad{border-color:var(--rust);background:var(--bad)}
.benchbtns{display:flex;gap:10px;flex-wrap:wrap}

/* exam */
.returning{display:inline-block;background:var(--rust);color:#fff;padding:2px 10px;border-radius:3px;font-size:.9rem;margin-bottom:10px}
.stepline{font-size:.95rem;margin:0 0 6px!important;color:#4A3A5A}
.story{border-left:4px solid var(--ink);padding-left:14px}
.confirmed{background:var(--good);padding:8px 12px;border-radius:4px;font-size:.95rem}
.q{font-family:var(--head);font-weight:400;font-size:1.5rem;margin:14px 0 6px}
.opts{display:grid;gap:10px;margin:8px 0 0}
.opt{display:flex;gap:12px;align-items:flex-start;text-align:left;width:100%;font:inherit;color:var(--ink);background:#EEF2EB;border:2px solid var(--ink);border-radius:4px;padding:10px 14px;cursor:pointer}
.opt:hover:not(:disabled){background:#FBE3B4}
.opt:disabled{cursor:default}
.opt .k{flex:none;font-family:var(--head);font-size:1.3rem;line-height:1.2;width:1.4em}
.opt.right{background:var(--good)}
.opt.wrong{background:var(--bad)}
.opt.dim{opacity:.55}
.fb{margin-top:14px}
.fb .verdict-t{font-family:var(--head);font-size:1.5rem;margin:0 0 4px}
fieldset.lensctl{border:2px solid var(--ink);border-radius:4px;margin:10px 0;padding:8px 12px 12px}
fieldset.lensctl legend{padding:0 6px}
.rads{display:flex;gap:8px;flex-wrap:wrap}
.rad{position:relative;display:inline-block;border:2px solid var(--ink);border-radius:4px;padding:6px 12px;background:#EEF2EB;cursor:pointer;font-size:.95rem}
.rad input{position:absolute;opacity:0;inset:0;cursor:pointer}
.rad.on{background:var(--amber)}
.rad:focus-within{outline:3px solid var(--rust);outline-offset:2px}
.strength{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:12px 0 4px}
.strength input[type=range]{flex:1 1 200px;max-width:340px;accent-color:var(--rust)}
.strength output{font-family:var(--head);font-size:1.5rem;min-width:4.2em}
.submitbox{border-top:2px dashed var(--ink);margin-top:16px;padding-top:6px}
.restext{display:block;width:100%;font:inherit;font-size:.9rem;line-height:1.45;border:2px solid var(--ink);border-radius:4px;background:#EEF2EB;color:var(--ink);padding:8px 10px;margin:8px 0 12px;resize:vertical}
a.btn{display:inline-block;text-decoration:none}
.stats{list-style:none;padding:0;margin:0 0 14px}
.stats li{padding:4px 0;border-bottom:1px dashed var(--ink)}


/* levels 2 and 3 */
.rs{cursor:pointer}
.rs .hitr{fill:transparent;stroke:transparent;stroke-width:2}
.rs:hover .hitr{stroke:#FFD479;stroke-dasharray:5 4}
.rs.done .hitr{fill:rgba(143,205,180,.16);stroke:#8FCDB4;stroke-dasharray:none}
.rs:focus-visible{outline:none}
.rs:focus-visible .hitr{stroke:#fff;stroke-width:3}
.rs .nb{display:none}
.rs.done .nb{display:block}
#ret text,#bars text,#light text{font-family:var(--body);fill:#E3F4EE;font-size:16px}
#ret .nb circle{fill:#8FCDB4}
#ret .nb text{fill:#0C1A18;font-size:15px;text-anchor:middle}
#ret [data-cone].off{fill:none!important;stroke:#7B8B86!important;stroke-width:1.5!important;stroke-dasharray:3 3}
#ret,#stage,#light,#bars,#dress{width:100%;height:auto;display:block}
#stage text{font-family:var(--body)}
.presets,.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}
.chipb{font:inherit;font-size:.9rem;color:var(--ink);background:#EEF2EB;border:2px solid var(--ink);border-radius:4px;padding:5px 12px;cursor:pointer}
.chipb:hover{background:#FBE3B4}
.chipb[aria-pressed=true]{background:var(--amber)}
.srow{display:grid;grid-template-columns:minmax(150px,1.3fr) minmax(120px,2fr) 3.4em auto;gap:10px;align-items:center;margin:6px 0}
.srow output{font-family:var(--head);font-size:1.3rem}
.srow input[type=range]{accent-color:var(--rust);width:100%}
.checks{list-style:none;padding:0;margin:8px 0 12px}
.checks li{padding:3px 0;font-size:.95rem}
.checks li.ok{color:#2D6A36}
.mini{font-size:.85rem;margin:6px 0 4px;color:#8FC5B6}
.facts{font-size:.92rem;line-height:1.5;margin:0}
.cvd{filter:url(#fCvd)}
.cvdT{filter:url(#fTgt)}
.plates{display:flex;gap:10px}
.plates>div{flex:1;min-width:0}
canvas.plate{width:100%;height:auto;border-radius:50%;display:block;background:#E8E4D6}
.sw{display:inline-block;width:1.6em;height:1.1em;border:2px solid var(--ink);border-radius:3px;vertical-align:middle;margin-left:6px}
#wlChart{width:100%;max-width:440px;display:block;margin:10px 0}
.sws{display:flex;gap:8px}
.swb{flex:1;height:44px;border:2px solid #9FD3C6;border-radius:4px}
.ends{display:flex;justify-content:space-between;font-size:.85rem;margin:0 0 10px;max-width:440px}
@media (max-width:640px){.srow{grid-template-columns:1fr 3.4em auto}.srow label{grid-column:1/-1}}

/* Level 2: Monitor 2 sits under Frank and stays on screen while the page scrolls */
.lab.m2left{grid-template-columns:380px minmax(0,1fr)}
.leftcol{display:flex;flex-direction:column;gap:14px;align-self:stretch;min-width:0}
.leftcol .scene{position:static;display:grid;grid-template-columns:150px 1fr;gap:14px;align-items:center}
.leftcol .meter{margin-top:0}
.pin{position:sticky;top:12px;max-height:calc(100vh - 24px);overflow-y:auto}
.pin .monitor{margin-bottom:0}
.monitor.single{grid-template-columns:1fr}
.leftcol canvas.plate{max-width:250px;margin:0 auto}
.leftcol .plates canvas.plate{max-width:none}
.leftcol .chipb{font-size:.82rem;padding:4px 9px}
@media (max-width:900px){
  .lab.m2left{grid-template-columns:1fr}
  .pin{position:static;max-height:none}
}
/* levels 4 and 5 */
#ear,#wave,#aud{width:100%;height:auto;display:block}
#ear text,#wave text,#aud text{font-family:var(--body);fill:#CBEADF}
#ear .lab-t text{fill:#E3F4EE;font-size:17px}
#ear text.tobrain{fill:#9FD3C6;font-size:14px}
.legend{list-style:none;margin:8px 0 0;padding:0;font-size:.8rem;line-height:1.5}
.lg{display:inline-block;width:.9em;height:.9em;border-radius:50%;margin-right:.5em;vertical-align:-.1em}
.tipnote{margin:10px 0 0;padding:8px 10px;border-left:4px solid #FFD479;background:rgba(255,212,121,.1);font-size:.9rem;line-height:1.45}
.dotkey{display:inline-block;width:.8em;height:.8em;border-radius:50%;background:#fff;border:2px solid #F5A524;margin-right:.5em;vertical-align:-.05em}
.fb .btn{margin:8px 8px 0 0}
.lvlrow{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.score{background:var(--good);color:var(--ink);padding:3px 10px;border-radius:3px;font-size:.9rem}
.sendlink{display:inline-block;margin-top:8px;font-size:.9rem;color:#FFD479}
.sendlink:hover{color:#fff}
.vocab{border:2px solid var(--ink);border-radius:4px;background:#EEF2EB;padding:6px 12px;margin:8px 0 12px;font-size:.92rem}
.vocab summary{cursor:pointer;font-family:var(--head);font-size:1.2rem}
.vocab dl{margin:6px 0 4px}
.vocab dt{font-weight:bold;margin-top:8px}
.vocab dd{margin:0}
#flashlayer{position:fixed;inset:0;background:#FFF6D6;opacity:0;pointer-events:none;z-index:70}
@media (prefers-reduced-motion:no-preference){
  .flash{animation:flash 1.6s ease-out forwards}
  .slot.hint .sl{animation:pulse .7s ease-in-out 4}
  .tsp{animation:zap .5s steps(2) infinite}
}
@keyframes flash{0%{opacity:0}8%{opacity:1}16%{opacity:.2}26%{opacity:.9}100%{opacity:0}}
@keyframes pulse{50%{fill:rgba(255,212,121,.7);stroke:#fff}}
@keyframes zap{50%{opacity:.3}}
.slot.hint .sl{stroke:#fff;stroke-width:4}

@media (max-width:1000px){ .monitor{grid-template-columns:1fr} }
@media (max-width:800px){
  .bar h1{font-size:2rem}
  .home{grid-template-columns:1fr}
  .lab{grid-template-columns:1fr;gap:12px}
  .scene{position:static;display:grid;grid-template-columns:120px 1fr;gap:14px;align-items:center}
  .meter{margin-top:0}
  .panel{padding:18px 16px 20px}
  .bench{padding:16px 14px 18px}
}
</style>
</head>
<body>
<div id="flashlayer" aria-hidden="true"></div>
<div class="wrap">
  <header class="bar">
    <h1>Frank’s Laboratory</h1>
    <div class="bar-right">
      <button class="chip" id="homeBtn" type="button" hidden>Level select</button>
      <button class="chip" id="muteBtn" type="button" aria-pressed="false">Sound: on</button>
    </div>
  </header>
  <main id="app"></main>
</div>

<script>
"use strict";
const $ = (s,r) => (r||document).querySelector(s);
const $$ = (s,r) => Array.from((r||document).querySelectorAll(s));
const esc = s => String(s).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
function shuffleDiff(a){let o;do{o=shuffle(a);}while(a.length>1&&o.join()===a.join());return o;}
const reduceMotion = () => window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
const app = $("#app");

/* ============ RESULT SUBMISSION (teacher setup) ============
   Optional. To collect results in a Google Form:
   1. Build a form with short-answer questions (name, level, parts misplaced, hints, first-try exams, time, date).
   2. In the form, open the three-dot menu > "Get pre-filled link", type a sample answer in each question,
      press "Get link", and copy it.
   3. Put the form address in formUrl and each question's entry number in FORM_ENTRIES (7 per level, in FORM_FIELDS order).
   Leave formUrl empty and students get a "Copy my results" button only (good for pasting into a Canvas text-entry assignment). */
const FORM_FIELDS = ["name","level","partsWrong","hints","firstTry","time","date"];   /* order of the 7 questions per level */
const FORM_ENTRIES = {
  1:[1421926064,2038952971,1329271628,172023496,1947720382,733677039,410027278],
  2:[330549208,187798023,1466355405,1858040270,25085592,857146693,1989259212],
  3:[955670482,355974602,1618850904,813174662,787632843,1408417365,760645235],
  4:[1409893103,611360330,171397817,86358980,854257725,656437255,1632913610],
  5:[225666256,1281819255,643334394,944415312,156022701,1320608544,1156007949]
};
const LEVEL_NAMES={1:"Level 1: The eye",2:"Level 2: The retina",3:"Level 3: Opponent processes and the dress",4:"Level 4: The ear",5:"Level 5: Hearing loss"};
/* Save a finished level. A replay only replaces the saved score if it is at least as good. */
function recordLevel(n,st){
  const rec={done:true,date:new Date().toISOString(),firstTry:st.firstTry,total:st.total,wrong:st.wrong,hints:st.hints,secs:st.secs}, prev=save.levels[n];
  const better=!prev||!prev.done||rec.firstTry>prev.firstTry||(rec.firstTry===prev.firstTry&&rec.wrong<=prev.wrong);
  save.levels[n]=better?rec:Object.assign({},prev,{done:true});
  Store.save(save);
}
const SUBMIT = {
  formUrl: "https://docs.google.com/forms/d/e/1FAIpQLScSoCWxJRNIYlHn3CRZ7fMqZ575_kCOteXXBaPfT8Xo7TUgVg/viewform"
};
function formLink(d,levelNum){
  if(!SUBMIT.formUrl || !FORM_ENTRIES[levelNum]) return "";
  const base=SUBMIT.formUrl.split("?")[0].replace(/\/(viewform|formResponse).*$/,"")+"/viewform";
  const q=["usp=pp_url"];
  FORM_FIELDS.forEach((k,i)=>{ if(d[k]!==undefined) q.push("entry."+FORM_ENTRIES[levelNum][i]+"="+encodeURIComponent(d[k])); });
  return base+"?"+q.join("&");
}
async function copyText(t){
  try{ await navigator.clipboard.writeText(t); return true; }
  catch(e){
    const ta=$("#resText"); if(!ta) return false;
    try{ ta.removeAttribute("readonly"); ta.focus(); ta.select(); const ok=document.execCommand("copy"); ta.setAttribute("readonly",""); return !!ok; }
    catch(_){ ta.setAttribute("readonly",""); return false; }
  }
}

/* ============ storage (browser only; private to each device) ============ */
const Store = {
  key:"frankLab.v1", mem:null,
  blank(){return {name:"",muted:false,levels:{}};},
  load(){
    try{const r=localStorage.getItem(this.key); if(r){const o=JSON.parse(r); if(o&&typeof o==="object") return Object.assign(this.blank(),o);}}catch(e){}
    return this.mem||this.blank();
  },
  save(d){this.mem=d; try{localStorage.setItem(this.key,JSON.stringify(d));}catch(e){}}
};
let save = Store.load();
if(!save.levels) save.levels = {};

/* ============ sound (synthesized, quiet by default) ============ */
const Snd = {
  ctx:null, muted:!!save.muted,
  ensure(){
    if(this.muted) return null;
    if(!this.ctx){try{this.ctx=new (window.AudioContext||window.webkitAudioContext)();}catch(e){return null;}}
    if(this.ctx.state==="suspended") this.ctx.resume();
    return this.ctx;
  },
  tone(freq,dur,type,vol,when,slideTo){
    const c=this.ensure(); if(!c) return;
    const t=c.currentTime+(when||0), o=c.createOscillator(), g=c.createGain();
    o.type=type||"sine"; o.frequency.setValueAtTime(freq,t);
    if(slideTo) o.frequency.exponentialRampToValueAtTime(slideTo,t+dur);
    g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(vol||.06,t+.01); g.gain.exponentialRampToValueAtTime(0.0001,t+dur);
    o.connect(g); g.connect(c.destination); o.start(t); o.stop(t+dur+.03);
  },
  noise(dur,vol,lp,when){
    const c=this.ensure(); if(!c) return;
    const t=c.currentTime+(when||0), n=Math.floor(c.sampleRate*dur), buf=c.createBuffer(1,n,c.sampleRate), d=buf.getChannelData(0);
    for(let i=0;i<n;i++) d[i]=(Math.random()*2-1)*(1-i/n);
    const s=c.createBufferSource(); s.buffer=buf;
    const f=c.createBiquadFilter(); f.type="lowpass"; f.frequency.value=lp||800;
    const g=c.createGain(); g.gain.value=vol||.08;
    s.connect(f); f.connect(g); g.connect(c.destination); s.start(t);
  },
  place(){this.tone(520,.12,"triangle",.06); this.tone(780,.16,"triangle",.05,.08);},
  wrong(){this.tone(150,.2,"sawtooth",.04,0,100);},
  zap(){this.noise(.25,.06,3000); this.tone(900,.25,"square",.025,0,200);},
  thunder(){this.noise(1.8,.12,350); this.tone(70,1.2,"sine",.08,.05,35);}
};
