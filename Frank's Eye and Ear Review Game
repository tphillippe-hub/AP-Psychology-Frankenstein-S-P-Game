/* light rays: simple paraxial model */
function buildRays(g,cfg){
  const cy=210, offs=[-66,-44,-22,0,22,44,66], out=[];
  for(const o of offs){
    let h=o; const pts=[[0,cy+h]];
    if(cfg.showCL){pts.push([110,cy+h]); h=h*(1-145*.0006*cfg.P);}
    pts.push([255,cy+h]);
    const qc=cfg.cornea?.8:1, yl=cy+h*qc, yAt=x=>cy+h+(yl-(cy+h))*(x-255)/90;
    if(cfg.iris){const yi=yAt(306); if(Math.abs(yi-cy)>50){pts.push([306,yi]); out.push({pts:pts,blocked:true}); continue;}}
    pts.push([345,yl]);
    let yR;
    if(cfg.lens && cfg.focusX){const s=(cy-yl)/(cfg.focusX-345); yR=x=>yl+s*(x-345);}
    else {const s=(yl-(cy+h))/90; yR=x=>yl+s*(x-345);}
    const yEnd=yR(g.retX); pts.push([retinaXAt(g,yEnd),yEnd]);
    out.push({pts:pts,blocked:false});
  }
  return out;
}

