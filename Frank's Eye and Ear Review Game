/* ---------- drawing ---------- */
function drawEyeSVG(){
  const exam=L1.phase!=="assemble";
  const R=exam&&L1.cur?L1.cur.R:0;
  const g=geom(585-K*R);
  let s=eyeOutline(g), labels="";
  for(const id of ["retina","nerve","fovea","ciliary","iris","lens","cornea"]){
    const p=PART[id];
    if(exam||L1.placed.has(id)){
      s+=`<g class="pl">${p.draw(g,true)}</g>`;
      if(!exam) labels+=labelSVG(p.label(g));
    } else {
      s+=`<g class="slot" data-slot="${id}" tabindex="0" role="button" aria-label="Empty place in the eye. Select it to put the chosen part here.">${p.hit(g)}${p.draw(g,false)}</g>`;
    }
  }
  let rays, P=0, showCL=false, focusX;
  if(exam){
    P=curP(); showCL=L1.lens.type!=="none"&&L1.lens.str>0; focusX=585-K*P;
    rays=buildRays(g,{cornea:true,lens:true,iris:true,focusX:focusX,P:P,showCL:showCL});
  } else {
    const c=L1.placed.has("cornea"), l=L1.placed.has("lens");
    focusX=c&&l?585:(c?705:(l?900:null));
    rays=buildRays(g,{cornea:c,lens:l,iris:L1.placed.has("iris"),focusX:focusX,P:0,showCL:false});
  }
  s+=`<g class="rays">${rays.map(r=>`<polyline points="${r.pts.map(p=>f1(p[0])+","+f1(p[1])).join(" ")}" fill="none" stroke="#FFD479" stroke-width="2" opacity="${r.blocked?.4:.95}"/>`).join("")}</g>`;
  const hits=rays.filter(r=>!r.blocked).map(r=>r.pts[r.pts.length-1]);
  if(hits.length&&(L1.placed.has("retina")||exam)){
    const ys=hits.map(p=>p[1]), y0=Math.min.apply(null,ys), y1=Math.max.apply(null,ys), xm=retinaXAt(g,(y0+y1)/2);
    s+=`<line class="rays" x1="${f1(xm)}" y1="${f1(y0)}" x2="${f1(xm)}" y2="${f1(Math.max(y1,y0+3))}" stroke="#fff" stroke-width="6" stroke-linecap="round" opacity=".9"/>`;
  }
  s+=labels;
  if(exam){
    s+=clSVG(L1.lens.type,L1.lens.str);
    if(L1.phase==="exam"&&L1.step==="fix"){
      s+=`<g class="rays"><circle cx="${f1(focusX)}" cy="210" r="6" fill="none" stroke="#fff" stroke-width="2"/><text class="fm" x="${f1(focusX)}" y="190" text-anchor="middle">Rays cross</text></g>`;
    }
  }
  return s;
}
function assembleFx(pl){
  if(!pl.has("retina")) return {mode:"dark"};
  if(!pl.has("nerve")) return {mode:"static"};
  const base=(pl.has("cornea")?0:7)+(pl.has("lens")?0:3.2);
  return {mode:"ok",far:base,near:base+(pl.has("ciliary")?0:3.8),glare:pl.has("iris")?0:.72,smudge:pl.has("fovea")?0:1};
}
function assembleVerdict(pl){
  if(!pl.has("retina")) return "Frank sees nothing. Without a retina, no light is detected.";
  if(!pl.has("nerve")) return "No signal. The retina detects light, but nothing carries the message to the brain.";
  const b=[];
  if(!pl.has("cornea")) b.push("very blurry (the cornea does most of the bending)");
  if(!pl.has("lens")) b.push("out of focus (no lens to fine-tune it)");
  if(!pl.has("iris")) b.push("washed out (no iris to limit the light)");
  if(!pl.has("ciliary")) b.push("close-up objects blur (the lens can’t change shape)");
  if(!pl.has("fovea")) b.push("a smudge at the center (no area of sharp detail)");
  return b.length ? "Frank’s view: "+b.join("; ")+"." : "Frank sees clearly!";
}
function updateView(){
  let fx, text;
  if(L1.phase==="assemble"){ fx=assembleFx(L1.placed); text=assembleVerdict(L1.placed); }
  else {
    const R=L1.cur?L1.cur.R:0, res=R-curP(), m=Math.abs(res)<=TOL?0:Math.min(11,Math.abs(res)*3), myo=res<0;
    fx={mode:"ok",far:m*(myo?1:.4),near:m*(myo?.4:1),glare:0,smudge:0};
    text = L1.phase==="done" ? "Frank sees clearly!" : (m===0 ? "Sharp. Near and far objects are both in focus." : "Blurry. Compare the book (near) with the window (far).");
  }
  applyView(fx);
  $("#verdict").textContent=text;
}
