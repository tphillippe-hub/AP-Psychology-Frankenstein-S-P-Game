function lensChanged(){
  if($("#str")){
    $("#str").value=String(L1.lens.str); $("#str").disabled=L1.lens.type==="none"||L1.locked;
    const P=curP(), sign=P<0?"−":(P>0?"+":"");
    $("#strOut").textContent=`${sign}${Math.abs(P).toFixed(1)} D`;
    $$("input[name=lt]").forEach(r=>{r.checked=r.value===L1.lens.type; r.disabled=L1.locked; r.closest(".rad").classList.toggle("on",r.checked);});
    const res=L1.cur.R-P, where=Math.abs(res)<=TOL?"on the retina":(res<0?"in front of the retina":"behind the retina");
    $("#readout").textContent=`Light from far objects now focuses ${where}.`;
  }
  redrawEyeOnly();
}
function answerDx(i,ok){
  if(L1.locked) return; L1.locked=true; L1.answers++;
  const c=L1.cur, correct=condName(c.R);
  $$("#opts .opt").forEach((b,j)=>{
    b.disabled=true; const isRight=L1.opts[j]===correct;
    if(isRight){b.classList.add("right"); b.firstChild.textContent="✓";}
    else if(j===i){b.classList.add("wrong"); b.firstChild.textContent="✗";}
    else b.classList.add("dim");
  });
  const fb=$("#fb");
  if(ok){ Snd.place(); if(L1.retry&&L1.curMissed){ L1.queue=L1.queue.filter(x=>x!==c.id); L1.curMissed=false; L1.curQueued=false; } L1.retry=false; }
  else {Snd.wrong(); markMiss();}
  fb.innerHTML=`<p class="verdict-t">${ok?"Diagnosis confirmed.":"Misdiagnosis."}</p><p>${DX_WHY[kind(c.R)]}</p>${ok?"":"<p>Try this question again right now, or move on and this exam will come back later.</p>"}`;
  const nb=document.createElement("button"); nb.type="button"; nb.className="btn"; nb.textContent="Continue to lens fitting";
  nb.addEventListener("click",()=>{L1.step="fix"; L1.locked=false; refresh();});
  if(!ok){
    const rb=document.createElement("button"); rb.type="button"; rb.className="btn"; rb.textContent="Try this question again now";
    rb.addEventListener("click",()=>{L1.retry=true; L1.locked=false; renderExam();});
    nb.className="btn ghost"; nb.textContent="Move on to lens fitting"; fb.appendChild(rb); fb.appendChild(nb); rb.focus();
  } else { fb.appendChild(nb); nb.focus(); }
}
function prescribe(){
  if(L1.locked) return;
  const c=L1.cur, P=curP(), res=c.R-P, ok=Math.abs(res)<=TOL, fb=$("#fb"); L1.answers++;
  if(ok){
