/* drag and drop with pointer events (mouse, touch, pen) */
let drag=null;
function makeGhost(id,lv){const d=document.createElement("div"); d.className="ghost-drag"; d.innerHTML=lv===4?earIcon(EAR_PART[id]):iconSVG(PART[id]); return d;}
app.addEventListener("pointerdown",e=>{
  const b=e.target.closest&&e.target.closest(".part");
  const lv=(L1&&L1.phase==="assemble")?1:((L4&&L4.phase==="assemble")?4:0);
  if(!b||b.disabled||!lv) return;
  drag={lv:lv,id:b.dataset.part,btn:b,sx:e.clientX,sy:e.clientY,moved:false,ghost:null,pid:e.pointerId};
  try{b.setPointerCapture(e.pointerId);}catch(_){}
});
window.addEventListener("pointermove",e=>{
  if(!drag||e.pointerId!==drag.pid) return;
  if(!drag.moved&&Math.hypot(e.clientX-drag.sx,e.clientY-drag.sy)>7){
    drag.moved=true; drag.ghost=makeGhost(drag.id,drag.lv); document.body.appendChild(drag.ghost); drag.btn.classList.add("dragging");
  }
  if(drag.moved) drag.ghost.style.transform=`translate(${e.clientX-38}px,${e.clientY-30}px)`;
});
function endDrag(e,cancel){
  if(!drag||e.pointerId!==drag.pid) return;
  const d=drag; drag=null;
  d.btn.classList.remove("dragging"); if(d.ghost) d.ghost.remove();
  if(cancel) return;
  if(!d.moved){ if(d.lv===4) selectEar(d.id); else selectPart(d.id); return; }
  if(d.lv===4) dropEar(d.id,e.clientX,e.clientY); else dropPart(d.id,e.clientX,e.clientY);
}
window.addEventListener("pointerup",e=>endDrag(e,false));
window.addEventListener("pointercancel",e=>endDrag(e,true));
app.addEventListener("click",e=>{
  const b=e.target.closest&&e.target.closest(".part");
  if(b&&e.detail===0){ if(L1&&L1.phase==="assemble") selectPart(b.dataset.part); else if(L4&&L4.phase==="assemble") selectEar(b.dataset.part); }   /* keyboard activation */
});
function dropPart(id,cx,cy){
  const svg=$("#eye"); if(!svg||!svg.createSVGPoint) return;
  const r=svg.getBoundingClientRect();
  if(cx<r.left-10||cx>r.right+10||cy<r.top-10||cy>r.bottom+10) return;
  const m=svg.getScreenCTM(); if(!m) return;
  const pt=svg.createSVGPoint(); pt.x=cx; pt.y=cy; const p=pt.matrixTransform(m.inverse());
  let best=null, bd=1e9;
  for(const part of PARTS){
    if(L1.placed.has(part.id)) continue;
    for(const a of part.anchors(G0)){const d=Math.hypot(p.x-a[0],p.y-a[1]); if(d<bd){bd=d;best=part.id;}}
  }
  if(best&&bd<=72) placeAttempt(id,best);
  else say("Drop the part right onto one of the dashed places on Monitor 1.","");
}

/* ---------- phase 2: eye exams with mastery loop ---------- */
function startExams(){
