  },
  tone(freq,eff,vol,dur){
    const ctx=Snd.ensure(); if(!ctx||eff.gain<=0) return 0;
    dur=Math.max(.6,dur||1.2);
    this.stop(); const t=ctx.currentTime+.03, o=ctx.createOscillator(), lp=ctx.createBiquadFilter(), g=ctx.createGain(), comp=ctx.createDynamicsCompressor();
