    if(robotic){
      const bp=ctx.createBiquadFilter(); bp.type="bandpass"; bp.frequency.value=1200; bp.Q.value=.5; prev.connect(bp); prev=bp;
      const am=ctx.createGain(); am.gain.value=.55; const lfo=ctx.createOscillator(); lfo.frequency.value=70; const lg=ctx.createGain(); lg.gain.value=.45;
      lfo.connect(lg); lg.connect(am.gain); lfo.start(); prev.connect(am); prev=am;
    }
    const comp=ctx.createDynamicsCompressor(), out=ctx.createGain(); out.gain.value=.5; prev.connect(comp); comp.connect(out); out.connect(ctx.destination);
    return {input:input,out:out};
  },
  note(ctx,dst,t,f,type,v,dur){
    const o=ctx.createOscillator(), g=ctx.createGain(); o.type=type; o.frequency.value=f;
    g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(v,t+.02); g.gain.exponentialRampToValueAtTime(0.0001,t+dur);
    o.connect(g); g.connect(dst); o.start(t); o.stop(t+dur+.03);
  },
  melody(ctx,dst,t0){
    [[293.7,0],[349.2,.35],[440,.7],[587.3,1.05],[440,1.4],[349.2,1.75],[880,2.1],[1174.7,2.45],[1568,2.8],[2093,3.15]].forEach(n=>{
      this.note(ctx,dst,t0+n[1],n[0],"triangle",.3,.34); this.note(ctx,dst,t0+n[1],n[0]*3,"sine",.14,.3);
    }); return 3.6;
  },
  ambience(ctx,dst,t0){
    const n=Math.floor(ctx.sampleRate*1.8), buf=ctx.createBuffer(1,n,ctx.sampleRate), d=buf.getChannelData(0);
    for(let i=0;i<n;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/n,1.5);
    const s=ctx.createBufferSource(); s.buffer=buf; const lp=ctx.createBiquadFilter(); lp.type="lowpass"; lp.frequency.value=220; const g=ctx.createGain(); g.gain.value=.9;
    s.connect(lp); lp.connect(g); g.connect(dst); s.start(t0);
