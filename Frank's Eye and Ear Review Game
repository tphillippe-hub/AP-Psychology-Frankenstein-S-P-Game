  function next(){
    if(!Q.queue.length){ o.onDone({firstTry:Q.firstTry,total:o.items.length}); return; }
    Q.cur=Q.queue.shift(); Q.curMissed=false; Q.curQueued=false; Q.locked=false; Q.retry=false; render();
  }
  function render(){
    const it=o.items[Q.cur], returning=!!Q.missed[Q.cur];
    $("#bench").innerHTML=`<h3 class="bt">${esc(o.title)}</h3>${Q.retry?'<span class="returning">Second try</span>':(returning?'<span class="returning">Returning question: you missed this earlier</span>':"")}
     <p class="stepline">${Q.done.size} of ${o.items.length} questions mastered</p>
     ${it.story?`<p class="story">${esc(it.story)}</p>`:""}<h4 class="q">${esc(it.q)}</h4><div class="opts" id="qopts"></div><div class="fb" id="qfb" aria-live="polite"></div>`;
    Q.opts=shuffle([{t:it.right,ok:true}].concat(it.wrong.map(t=>({t:t,ok:false}))));
    const list=$("#qopts");
    Q.opts.forEach((op,i)=>{const b=document.createElement("button"); b.type="button"; b.className="opt"; b.innerHTML=`<span class="k">${i+1}</span><span>${esc(op.t)}</span>`; b.addEventListener("click",()=>answer(i)); list.appendChild(b);});
  }
  function answer(i){
    if(Q.locked) return; Q.locked=true;
    const it=o.items[Q.cur], ok=Q.opts[i].ok;
    $$("#qopts .opt").forEach((b,j)=>{b.disabled=true; if(Q.opts[j].ok){b.classList.add("right");b.firstChild.textContent="✓";} else if(j===i){b.classList.add("wrong");b.firstChild.textContent="✗";} else b.classList.add("dim");});
    const fb=$("#qfb");
    fb.innerHTML=`<p class="verdict-t">${ok?"Correct.":"Not quite."}</p><p>${esc(it.why)}</p>${ok?(Q.retry?"<p>Well done. You won’t need to see this one again.</p>":""):"<p>Try this question again right now, or move on and it will come back later.</p>"}`;
    if(ok){ Snd.place();
      if(Q.retry&&Q.curMissed){ Q.queue=Q.queue.filter(x=>x!==Q.cur); Q.curMissed=false; Q.curQueued=false; }
      if(!Q.curMissed){Q.done.add(Q.cur); if(!Q.missed[Q.cur]) Q.firstTry++;} }
    else { Snd.wrong(); if(!Q.curMissed){Q.curMissed=true; Q.missed[Q.cur]=(Q.missed[Q.cur]||0)+1; if(o.onWrong) o.onWrong(); if(!Q.curQueued){Q.curQueued=true; Q.queue.splice(Math.min(2,Q.queue.length),0,Q.cur);}} }
    if(o.onProgress) o.onProgress(Q.done.size);
    const nb=document.createElement("button"); nb.type="button"; nb.className="btn"; nb.textContent=Q.queue.length?"Next question":"Continue"; nb.addEventListener("click",next);
    if(!ok){
      const rb=document.createElement("button"); rb.type="button"; rb.className="btn"; rb.textContent="Try this question again now";
      rb.addEventListener("click",()=>{Q.retry=true; Q.locked=false; render();});
      nb.className="btn ghost"; nb.textContent="Move on (it comes back later)"; fb.appendChild(rb); fb.appendChild(nb); rb.focus();
    } else { fb.appendChild(nb); nb.focus(); }
  }
  return {start:next};
}

