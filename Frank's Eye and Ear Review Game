  if(reduceMotion()) return l4PlayStatic();
  const g=$("#trace"); if(g) g.innerHTML="";
  if(!startEarAnim(manual)) $("#heard4").textContent="Nothing is built yet, so there is no path for the sound.";
}

/* ---- checkpoint ---- */
const L4_QUIZ=[
 {q:"What is the correct path of sound through the ear?",right:"Ear canal, eardrum, hammer, anvil, stirrup, oval window, cochlea",wrong:["Ear canal, oval window, eardrum, stirrup, anvil, hammer, cochlea","Eardrum, ear canal, hammer, stirrup, anvil, cochlea, oval window","Pinna, cochlea, hammer, anvil, stirrup, eardrum, auditory nerve"],why:"Sound travels from the ear canal to the eardrum, through the three bones (hammer, anvil, stirrup), into the cochlea through the oval window."},
 {q:"Which structures convert vibrations into neural signals (transduction)?",right:"Hair cells in the cochlea",wrong:["The eardrum","The three tiny bones","The pinna"],why:"Hair cells bend as fluid waves pass, and that bending makes them fire signals to the auditory nerve."},
 {q:"What is the main job of the hammer, anvil, and stirrup?",right:"To pass the eardrum’s vibrations on to the fluid-filled cochlea",wrong:["To detect different pitches","To send signals to the brain","To keep Frank balanced"],why:"The three bones link the eardrum to the oval window, carrying air-driven vibrations into the cochlea’s fluid."},
 {q:"A high-pitched tone makes which part of the cochlea’s membrane move the most?",right:"The base, near the oval window",wrong:["The tip, at the center of the spiral","The whole membrane equally","The auditory nerve"],why:"By place theory, high pitches peak near the base of the cochlea and low pitches near the tip. That is why the white dot moved along the spiral."},
 {q:"Frank hears perfectly but keeps losing his balance. Which structure is most likely damaged?",right:"The semicircular canals",wrong:["The cochlea","The eardrum","The auditory nerve"],why:"The semicircular canals sense head movement for balance (the vestibular sense). They sit beside the cochlea but are not part of hearing."},
 {q:"Where do sound vibrations move from the middle ear into the fluid of the inner ear?",right:"At the oval window, where the stirrup pushes",wrong:["At the eardrum","In the ear canal","At the pinna"],why:"The stirrup presses on the oval window, which sends pressure waves into the fluid of the cochlea."}
];
function l4Quiz(){
  clearL3Timer(); L4.phase="quiz"; $("#ear").classList.remove("armed"); l4Refresh();
  makeQuiz({title:"Sound checkpoint",items:L4_QUIZ,onWrong:()=>{L4.wrong++;},onProgress:n=>{L4.quizDone=n; paintMeterN(EAR_PARTS.length+n,EAR_PARTS.length+6,"Ear repair");},onDone:s=>{L4.firstTry=s.firstTry; finishL4();}}).start();
}
function finishL4(){
  L4.phase="done"; L4.amp=1; l4Refresh(); paintWave(1);
  const st={wrong:L4.wrong,hints:L4.hints,firstTry:L4.firstTry,total:L4_QUIZ.length,secs:Math.round((Date.now()-L4.start)/1000)};
  recordLevel(4,st);
  celebrate();
  renderLevelDone(4,"Level 4: The ear",st,{title:"Frank can hear!",body:(save.name?save.name+", you":"You")+" built Frank’s ear and traced a sound all the way to the brain."},startLevel4);
}

/* ==================================================================
   LEVEL 5: HEARING LOSS (conduction and sensorineural)
   ================================================================== */
const HAIRW=[1,.9,.75,.55,.35,.2,.1];
const HL_CASES=[
 {id:"wax",type:"conduction",cause:"wax",best:"clear",severity:"mild",air:[40,40,40,40,40,40],bone:[5,5,5,5,5,5],
  story:"Frank’s hearing in his left ear has been muffled ever since swamp mud dried inside it. The ear canal looks packed.",
  dxWhy:"The air line is much worse than the bone line. Sound is blocked on its way in, but vibrations through the skull reach a healthy cochlea normally. That air-bone gap is the sign of conduction hearing loss.",
  txWhy:"The blockage is the problem, so removing it restores natural hearing. A hearing aid would make up for it by being louder, but the blockage would still be there.",
  model:{wax:1}},
 {id:"ossicles",type:"conduction",cause:"ossicles",best:"surgery",severity:"moderate",air:[45,45,40,40,40,35],bone:[5,5,5,5,5,5],
  story:"Frank’s hearing in his left ear has slowly faded. His eardrum looks normal, but the tiny bones behind it have fused stiff.",
  dxWhy:"Air conduction is poor, but bone conduction is normal. The cochlea works, and the stiff ossicles are failing to pass the vibrations along, which is conduction hearing loss.",
  txWhy:"Middle-ear surgery repairs or replaces the stiff bones, which fixes the cause. A hearing aid helps by making things louder, but it doesn’t fix the bones.",
  model:{stiff:1}},
 {id:"drum",type:"conduction",cause:"eardrum",best:"surgery",severity:"mild",air:[40,35,30,25,20,20],bone:[5,5,5,5,5,5],
  story:"After a lightning blast, Frank’s left eardrum has a small hole in it, and sounds are muffled.",
  dxWhy:"Bone conduction is normal while air conduction is reduced, so the inner ear is fine. A damaged eardrum can’t pick up vibrations well, which is conduction loss.",
  txWhy:"A small repair to the eardrum (or the middle ear) fixes the cause and restores hearing. The inner ear was never the problem.",
  model:{hole:true}},
 {id:"noise",type:"sensorineural",cause:"noise",best:"aid",severity:"moderate",air:[10,10,15,30,50,60],bone:[10,10,15,30,50,60],
  story:"After years beside the lightning rod without ear protection, Frank can’t hear high-pitched sounds. Low rumbles are fine.",
  dxWhy:"The air and bone lines match, so sound reaches the cochlea but the hair cells can’t respond. Noise damage usually harms the hair cells for high pitches first, which is sensorineural loss.",
  txWhy:"Some hair cells still work, so a hearing aid’s amplification helps a lot. A cochlear implant is major surgery meant for much more severe loss.",
  model:{hairW:HAIRW.map(w=>w*.7),hairFrac:.45}},
 {id:"age",type:"sensorineural",cause:"age",best:"aid",severity:"moderate",air:[15,20,25,40,55,70],bone:[15,20,25,40,55,70],
  story:"Frank has noticed that birdsong and consonants are harder to hear as the years pass, especially in a noisy room.",
  dxWhy:"The air and bone lines sit together and slope downward at high pitches. That points to hair-cell loss in the cochlea (sensorineural), which is common with age.",
  txWhy:"Hearing aids amplify the pitches Frank still has hair cells for. Because the loss is moderate, an aid is the usual first choice.",
  model:{hairW:HAIRW.map(w=>w*.85),hairFrac:.55}},
 {id:"illness",type:"sensorineural",cause:"illness",best:"implant",severity:"profound",air:[85,90,95,100,105,110],bone:[85,90,95,100,105,110],
  story:"A fever destroyed nearly all of the hair cells in Frank’s left cochlea. He hears almost nothing, even very loud sounds.",
  dxWhy:"Air and bone conduction are both severely reduced, and the lines match. The hair cells are the problem, so this is sensorineural loss.",
  txWhy:"With almost no working hair cells, a hearing aid has little to amplify. A cochlear implant bypasses the hair cells and stimulates the auditory nerve directly.",
  model:{hairW:HAIRW.map(()=>1),hairFrac:1}}
];
const HL_BY=Object.fromEntries(HL_CASES.map(c=>[c.id,c]));
const TXS=[["clear","Clear the ear canal"],["surgery","Middle-ear surgery (repair the eardrum or the bones)"],["aid","Hearing aid (makes sound louder)"],["implant","Cochlear implant (stimulates the auditory nerve directly)"]];
function treat(c,tx){
  const norm=c.air.map(()=>BASE); let air=c.air.slice(), note="", quality="natural", fixed=false;
  const conduction=c.type==="conduction";
  if(tx==="clear"){
    if(c.cause==="wax"){air=norm; fixed=true; note="The blockage is gone and sound reaches the eardrum again. Hearing is back to normal.";}
    else note="There is nothing blocking this ear canal, so nothing changed.";
  } else if(tx==="surgery"){
    if(c.cause==="ossicles"||c.cause==="eardrum"){air=norm; fixed=true; note="The middle ear is repaired and vibrations pass through again. Hearing is back to normal.";}
    else note="The middle ear is not the problem here, so surgery changed nothing and only added risk.";
  } else if(tx==="aid"){
    air=c.air.map(a=>Math.max(BASE,Math.round(a-(a<=60?a*.85:(a<=85?a*.35:a*.05)))));
    note=conduction?"Louder sound makes up for the blocked path, so hearing improves a lot. But the underlying problem is still there, and a more direct fix exists."
      :(c.severity==="profound"?"Almost no benefit. Too few hair cells remain to respond, even to loud sound."
      :"Amplification helps the hair cells that still work, so sounds are louder and clearer. Hearing is not like new, but it is much better.");
  } else if(tx==="implant"){
    quality="robotic";
    if(c.severity==="profound"){air=c.air.map(()=>30); fixed=true; note="A big improvement. Electrodes bypass the dead hair cells and stimulate the auditory nerve directly. The sound is buzzy and robotic, but speech becomes understandable with practice.";}
    else {air=c.air.map(()=>35); note="It works, but it is major surgery that replaces hearing that could be helped in a simpler way, and natural sound quality is lost. It is not the best fit.";}
  }
  return {air:air,note:note,quality:quality,fixed:fixed};
}
function caseModel(c,tx,res){
  const m=Object.assign({},c.model);
  if(tx&&res){
    if(tx==="clear"&&res.fixed) m.wax=0;
    if(tx==="surgery"&&res.fixed){m.stiff=0; m.hole=false;}
    if(tx==="aid") m.aid=true;
    if(tx==="implant") m.implant=true;
  }
  return m;
}
/* the exploration lab uses two sliders */
function labProfile(L){
  const air=[],bone=[],eff=[];
  FQ.forEach((f,i)=>{
    const sn=L.sn*W6[i]; air.push(Math.round(BASE+L.cond+sn)); bone.push(Math.round(BASE+sn));
    eff.push(Math.round(BASE+(L.boost?Math.max(0,L.cond-30):L.cond)+Math.max(0,sn-(L.boost?10:0))));
  });
  return {air:air,bone:bone,eff:eff};
}
function listen(loss,opts,capId){
  const cap=$("#"+capId), text=heardCaption(loss,opts&&opts.robotic), dur=Hearing.play(loss,opts||{});
  if(cap) cap.textContent=text+(dur?"":(Snd.muted?" (Sound is off. Turn it on with the Sound button to hear it.)":" (This device could not play sound, but the description above still applies.)"));
}
let L5=null;
function startLevel5(){
  L5={phase:"lab",cond:0,sn:0,boost:false,tasks:{a:false,b:false,c:false,d:false},wrong:0,hints:0,firstTry:0,start:Date.now(),T:null,notice:"",noticeKind:""};
  $("#homeBtn").hidden=false; stopStatic(); clearL3Timer(); Hearing.stop();
  levelShell("Level 5: Hearing loss","Monitor 1: Frank’s left ear","Monitor 2: Hearing test (audiogram)",10,EAR_TABLE_SVG);
  $("#m1").innerHTML=`<svg id="ear" viewBox="0 0 840 420" role="img" aria-label="Frank’s ear, with damage shown in color"></svg>`;
  l5Lab(); window.scrollTo({top:0,behavior:"auto"});
}
function l5Progress(){
  const t=Object.values(L5.tasks).filter(Boolean).length, d=L5.T?L5.T.done.size:0;
  paintMeterN(t+d,10,"Hearing repair");
}
function l5Lab(){
  L5.phase="lab"; $("#phase").textContent="Part 1 of 2: Hearing lab";
  $("#bench").innerHTML=`<h3 class="bt">Hearing lab</h3>
   <p class="help">Damage Frank’s hearing in two different ways and compare. A <b>middle-ear problem</b> blocks sound on the way in (conduction). <b>Hair-cell damage</b> hurts the receptors for high pitches first (sensorineural). On the hearing test, the red air line is sound through the ear canal, and the blue bone line is vibration straight through the skull to the cochlea.</p>
   <div class="srow" style="grid-template-columns:minmax(150px,1.4fr) 2fr 4.5em"><label for="cond">Middle-ear problem</label><input id="cond" type="range" min="0" max="60" step="5" value="${L5.cond}"><output id="condOut" for="cond"></output></div>
   <div class="srow" style="grid-template-columns:minmax(150px,1.4fr) 2fr 4.5em"><label for="sn">Hair-cell damage</label><input id="sn" type="range" min="0" max="80" step="5" value="${L5.sn}"><output id="snOut" for="sn"></output></div>
   <div class="presets"><button type="button" class="chipb" id="boost" aria-pressed="${L5.boost}">Turn up the volume</button></div>
   <div class="benchbtns"><button type="button" class="btn" id="hearMel">Hear Frank: melody</button><button type="button" class="btn ghost" id="hearAmb">Hear Frank: thunder and creaks</button><button type="button" class="btn ghost" id="hearOk">Hear a healthy ear</button></div>
   <p class="readout" id="hcap" aria-live="polite" style="min-height:3em"></p>
   <p class="help">Try to complete all four:</p><ul class="checks" id="tasks"></ul>
   <div class="benchbtns"><button class="btn" id="toClinic" type="button" disabled>Continue to the hearing clinic</button></div>`;
  $("#cond").addEventListener("input",e=>{L5.cond=+e.target.value; l5LabPaint();});
  $("#sn").addEventListener("input",e=>{L5.sn=+e.target.value; l5LabPaint();});
  $("#boost").addEventListener("click",()=>{L5.boost=!L5.boost; $("#boost").setAttribute("aria-pressed",String(L5.boost)); l5LabPaint();});
  $("#hearMel").addEventListener("click",()=>listen(labProfile(L5).eff,{source:"melody"},"hcap"));
  $("#hearAmb").addEventListener("click",()=>listen(labProfile(L5).eff,{source:"ambience"},"hcap"));
  $("#hearOk").addEventListener("click",()=>listen(FQ.map(()=>BASE),{source:"melody"},"hcap"));
  $("#toClinic").addEventListener("click",l5Clinic);
  l5LabPaint();
}
function l5LabPaint(){
  const p=labProfile(L5), t=L5.tasks, before=Object.values(t).filter(Boolean).length;
  $("#condOut").textContent=L5.cond+" dB"; $("#snOut").textContent=L5.sn+" dB";
  $("#m2").innerHTML=audiogramSVG(p.air,p.bone,L5.boost?p.eff:null);
  const model={stiff:L5.cond/60,hairW:HAIRW.map(w=>Math.min(1,L5.sn/80*w)),hairFrac:Math.min(.9,L5.sn/80*.8)};
  $("#ear").innerHTML=drawEar({all:true,model:model,pitch:1000,nodot:true});
  const maxRes=Math.max.apply(null,p.eff.map(v=>v-BASE));
  if(L5.cond>=25&&L5.sn<10) t.a=true;
  if(L5.sn>=35&&L5.cond<10) t.b=true;
  if(L5.cond>=25&&L5.cond<=45&&L5.sn<10&&L5.boost&&maxRes<=15) t.c=true;
  if(L5.sn>=40&&L5.cond<10&&L5.boost&&p.eff[5]-BASE>=25) t.d=true;
  const txt={a:"Conduction loss: the air line drops, but the bone line stays normal",b:"Sensorineural loss: both lines drop, mostly at high pitches",c:"With a conduction loss, turn up the volume: hearing mostly returns",d:"With hair-cell damage, turn up the volume: high pitches stay faint"};
  $("#tasks").innerHTML=Object.keys(txt).map(k=>`<li class="${t[k]?"ok":""}">${t[k]?"✓":"○"} ${txt[k]}</li>`).join("");
  const after=Object.values(t).filter(Boolean).length; if(after>before) Snd.place();
  $("#toClinic").disabled=after<4; l5Progress();
}
/* ---- the clinic ---- */
function l5Clinic(){
  Hearing.stop(); L5.phase="clinic"; $("#phase").textContent="Part 2 of 2: Hearing clinic";
  L5.T={queue:shuffle(HL_CASES.map(c=>c.id)),done:new Set(),missed:{},first:0,cur:null,step:"dx",curMissed:false,curQueued:false,locked:false,tx:null,res:null,returning:false,opts:[]};
  l5Next();
}
function l5Next(){
  const T=L5.T; if(!T.queue.length){ finishL5(); return; }
  T.cur=HL_BY[T.queue.shift()]; T.step="dx"; T.curMissed=false; T.curQueued=false; T.locked=false; T.retry=false; T.tx=null; T.res=null; T.returning=!!T.missed[T.cur.id];
  Hearing.stop(); l5Render(); window.scrollTo({top:0,behavior:"auto"});
}
function l5Miss(){
  const T=L5.T; if(T.curMissed) return;
  T.curMissed=true; T.missed[T.cur.id]=(T.missed[T.cur.id]||0)+1; L5.wrong++;
  if(!T.curQueued){T.curQueued=true; T.queue.splice(Math.min(2,T.queue.length),0,T.cur.id);}
}
function l5Paint(){
  const T=L5.T, c=T.cur;
  $("#m2").innerHTML=audiogramSVG(c.air,c.bone,T.res?T.res.air:null);
  $("#ear").innerHTML=drawEar({all:true,model:caseModel(c,T.tx,T.res),pitch:1000,nodot:true});
  l5Progress();
}
function l5Render(){
  const T=L5.T, c=T.cur;
  let h=`<h3 class="bt">Hearing clinic</h3>${T.returning?'<span class="returning">Returning patient: you missed this case earlier</span>':""}
   <p class="stepline">${T.step==="dx"?"Step 1 of 2: Diagnose":"Step 2 of 2: Choose a treatment"}</p><p class="story">${esc(c.story)}</p>`;
  if(T.step==="dx"){
    h+=`<p class="help">Study the hearing test on Monitor 2, then listen to how Frank hears.</p>
     <div class="benchbtns"><button type="button" class="btn ghost" id="hearNow">Hear Frank’s hearing</button></div><p class="readout" id="hcap" aria-live="polite" style="min-height:3em"></p>
     <h4 class="q">What type of hearing loss is this?</h4><div class="opts" id="opts"></div><div class="fb" id="fb" aria-live="polite"></div>`;
    $("#bench").innerHTML=h; l5Paint();
    $("#hearNow").addEventListener("click",()=>listen(c.air,{source:"melody"},"hcap"));
    T.opts=shuffle(["Conduction hearing loss","Sensorineural hearing loss"]);
    T.opts.forEach((t,i)=>{const b=document.createElement("button"); b.type="button"; b.className="opt"; b.innerHTML=`<span class="k">${i+1}</span><span>${t}</span>`; b.addEventListener("click",()=>l5Dx(i)); $("#opts").appendChild(b);});
  } else {
    h+=`<p class="confirmed">Diagnosis confirmed: ${c.type==="conduction"?"Conduction hearing loss":"Sensorineural hearing loss"}</p>
     <h4 class="q">Which treatment fits best?</h4><div class="opts" id="txopts"></div>
     <div class="benchbtns" style="margin-top:12px"><button type="button" class="btn ghost" id="hearBefore">Hear before treatment</button><button type="button" class="btn ghost" id="hearAfter" disabled>Hear after treatment</button></div>
     <p class="readout" id="hcap" aria-live="polite" style="min-height:3em"></p><div class="fb" id="fb" aria-live="polite"></div>`;
    $("#bench").innerHTML=h; l5Paint();
    TXS.forEach((t,i)=>{const b=document.createElement("button"); b.type="button"; b.className="opt"; b.dataset.tx=t[0]; b.innerHTML=`<span class="k">${i+1}</span><span>${t[1]}</span>`; b.addEventListener("click",()=>l5Tx(t[0])); $("#txopts").appendChild(b);});
    $("#hearBefore").addEventListener("click",()=>listen(c.air,{source:"melody"},"hcap"));
    $("#hearAfter").addEventListener("click",()=>{ if(T.res) listen(T.res.air,{source:"melody",robotic:T.res.quality==="robotic"},"hcap"); });
  }
}
function l5Dx(i){
  const T=L5.T; if(T.locked) return; T.locked=true;
  const c=T.cur, label=c.type==="conduction"?"Conduction hearing loss":"Sensorineural hearing loss", ok=T.opts[i]===label;
  $$("#opts .opt").forEach((b,j)=>{b.disabled=true; if(T.opts[j]===label){b.classList.add("right");b.firstChild.textContent="✓";} else if(j===i){b.classList.add("wrong");b.firstChild.textContent="✗";} else b.classList.add("dim");});
  if(ok){ Snd.place(); if(T.retry&&T.curMissed){ T.queue=T.queue.filter(x=>x!==c.id); T.curMissed=false; T.curQueued=false; } T.retry=false; }
  else {Snd.wrong(); l5Miss();}
  const fb=$("#fb"); fb.innerHTML=`<p class="verdict-t">${ok?"Diagnosis confirmed.":"Misdiagnosis."}</p><p>${esc(c.dxWhy)}</p>${ok?"":"<p>Try this question again right now, or move on and this case will come back later.</p>"}`;
  const nb=document.createElement("button"); nb.type="button"; nb.className="btn"; nb.textContent="Continue to treatment";
  nb.addEventListener("click",()=>{T.step="tx"; T.locked=false; l5Render();});
  if(!ok){
    const rb=document.createElement("button"); rb.type="button"; rb.className="btn"; rb.textContent="Try this question again now";
    rb.addEventListener("click",()=>{T.retry=true; T.locked=false; l5Render();});
    nb.className="btn ghost"; nb.textContent="Move on to treatment"; fb.appendChild(rb); fb.appendChild(nb); rb.focus();
  } else { fb.appendChild(nb); nb.focus(); }
}
function l5Tx(tx){
  const T=L5.T, c=T.cur; if(T.locked) return;
  const res=treat(c,tx); T.tx=tx; T.res=res; l5Paint();
  $("#hearAfter").disabled=false;
  const fb=$("#fb"), best=tx===c.best, robotic=res.quality==="robotic";
  $("#hcap").textContent=heardCaption(res.air,robotic)+" (Press Hear after treatment to listen.)";
  if(best){
    T.locked=true; Snd.zap();
    if(!T.curMissed){T.done.add(c.id); if(!T.missed[c.id]) T.first++;}
    $$("#txopts .opt").forEach(b=>{b.disabled=true; if(b.dataset.tx===tx){b.classList.add("right"); b.firstChild.textContent="✓";} else b.classList.add("dim");});
    fb.innerHTML=`<p class="verdict-t">Best fit.</p><p>${esc(res.note)}</p><p>${esc(c.txWhy)}</p>${T.curMissed?"<p>Because you missed part of this case, it will return once more for a clean run.</p>":""}`;
    const nb=document.createElement("button"); nb.type="button"; nb.className="btn"; nb.textContent=T.queue.length?"Next patient":"Finish level"; nb.addEventListener("click",l5Next); fb.appendChild(nb); l5Progress(); nb.focus();
  } else {
    Snd.wrong(); l5Miss();
    fb.innerHTML=`<p class="verdict-t">Not the best fit.</p><p>${esc(res.note)}</p><p>Look at the audiogram again, then try a different treatment. This case will return later for a clean run.</p>`;
  }
}
function finishL5(){
  L5.phase="done"; $("#phase").textContent="Level complete"; L5.firstTry=L5.T.first;
  const st={wrong:L5.wrong,hints:L5.hints,firstTry:L5.firstTry,total:HL_CASES.length,secs:Math.round((Date.now()-L5.start)/1000)};
  recordLevel(5,st);
  $("#m2").innerHTML=audiogramSVG(FQ.map(()=>BASE),null,null); $("#ear").innerHTML=drawEar({all:true,pitch:1000,nodot:true});
  paintMeterN(10,10,"Hearing repair"); celebrate();
  renderLevelDone(5,"Level 5: Hearing loss",st,{title:"Frank hears the storm!",body:(save.name?save.name+", you":"You")+" diagnosed every hearing problem and matched it with a treatment."},startLevel5);
}

showHome();
</script>
