  stop(){
    if(this.cur){ try{const c=Snd.ctx; this.cur.out.gain.cancelScheduledValues(c.currentTime); this.cur.out.gain.setTargetAtTime(0,c.currentTime,.03);}catch(e){} this.cur=null; }
  },
  chain(ctx,loss,robotic){
    const input=ctx.createGain(); let prev=input;
    const add=(type,f,att)=>{ if(att<=.4) return; const b=ctx.createBiquadFilter(); b.type=type; b.frequency.value=f; b.Q.value=.9; b.gain.value=-att; prev.connect(b); prev=b; };
