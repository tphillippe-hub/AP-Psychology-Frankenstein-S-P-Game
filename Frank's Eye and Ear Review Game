    });
    $("#str").addEventListener("input",e=>{L1.lens.str=parseFloat(e.target.value); if(L1.lens.str>0&&L1.lens.type==="none"){L1.lens.type=(L1.cur.R<0?"concave":"convex");} lensChanged();});
