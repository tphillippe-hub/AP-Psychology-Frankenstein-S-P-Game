/* ============ eye geometry ============
   Light enters from the left. The back of the eyeball stretches or shrinks with the
   patient's refractive error, so a nearsighted eye is drawn longer and a farsighted eye shorter. */
const K = 26;                    /* pixels of focus shift per diopter */
function geom(retX){
  const b=170, k=Math.sqrt(1-Math.pow(98/b,2));
  const a=(retX+10-285)/(1+k), cx=retX+10-a;
  return {a:a,b:b,cx:cx,cy:210,retX:retX};
}
const G0 = geom(585);
const f1 = n => n.toFixed(1);
function eyeOutline(g){
  return `<path d="M285 112 A${f1(g.a)} ${g.b} 0 1 1 285 308" fill="#17302F" stroke="#DDE1D6" stroke-width="12" stroke-linejoin="round"/>`;
}
function retinaPath(g){
  const ar=g.a-9, br=158, t=62*Math.PI/180, x1=g.cx+ar*Math.cos(t), y1=g.cy-br*Math.sin(t), y2=g.cy+br*Math.sin(t);
  return `M${f1(x1)} ${f1(y1)} A${f1(ar)} ${br} 0 0 1 ${f1(x1)} ${f1(y2)}`;
}
function foveaPt(g){return [g.cx+g.a-9,210];}
function nerveCurve(g){
  const t=24*Math.PI/180, p0=[g.cx+g.a*Math.cos(t),210+170*Math.sin(t)];
  const c1=[p0[0]+50,p0[1]+8], c2=[p0[0]+120,p0[1]+30], p3=[Math.max(828,p0[0]+130),p0[1]+58];
  return {p0:p0,c1:c1,c2:c2,p3:p3,d:`M${f1(p0[0])} ${f1(p0[1])} C${f1(c1[0])} ${f1(c1[1])} ${f1(c2[0])} ${f1(c2[1])} ${f1(p3[0])} ${f1(p3[1])}`};
}
function bez(c,t){
  const u=1-t, w=[u*u*u,3*u*u*t,3*u*t*t,t*t*t], P=[c.p0,c.c1,c.c2,c.p3];
  return [0,1].map(i=>P.reduce((s,p,j)=>s+w[j]*p[i],0));
}
function retinaXAt(g,y){
  const ar=g.a-9, br=158, t=(y-210)/br;
  return Math.abs(t)>=1 ? g.cx+ar*.5 : g.cx+ar*Math.sqrt(1-t*t);
}

