      <label class="rad"><input type="radio" name="lt" value="none"> No lens</label>
      <label class="rad"><input type="radio" name="lt" value="concave"> Concave (thinner in the middle)</label>
      <label class="rad"><input type="radio" name="lt" value="convex"> Convex (thicker in the middle)</label>
     </div></fieldset>
     <div class="strength"><label for="str">Lens strength</label><input id="str" type="range" min="0" max="6" step="0.5" value="0"><output id="strOut" for="str"></output></div>
     <p class="readout" id="readout" aria-live="polite"></p>
     <div class="benchbtns" style="margin-top:12px"><button type="button" class="btn" id="rx">Prescribe this lens</button></div>
     <div class="fb" id="fb" aria-live="polite"></div>`;
    host.innerHTML=h;
    $$("input[name=lt]").forEach(r=>{
      r.checked=r.value===L1.lens.type; r.closest(".rad").classList.toggle("on",r.checked);
