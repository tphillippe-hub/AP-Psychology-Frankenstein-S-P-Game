}
function markMiss(){
  if(L1.curMissed) return;
  L1.curMissed=true; L1.missed[L1.cur.id]=(L1.missed[L1.cur.id]||0)+1;
  if(!L1.curQueued){ L1.curQueued=true; L1.queue.splice(Math.min(2,L1.queue.length),0,L1.cur.id); }
}
function renderExam(){
