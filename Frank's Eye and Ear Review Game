      const o=ctx.createOscillator(), og=ctx.createGain(); o.type="sine"; o.frequency.setValueAtTime(c[1],t0+c[0]); o.frequency.exponentialRampToValueAtTime(c[1]*.65,t0+c[0]+.28);
      og.gain.setValueAtTime(0.0001,t0+c[0]); og.gain.exponentialRampToValueAtTime(.22,t0+c[0]+.03); og.gain.exponentialRampToValueAtTime(0.0001,t0+c[0]+.3);
      o.connect(og); og.connect(dst); o.start(t0+c[0]); o.stop(t0+c[0]+.35);
    });
    [[.9,3400],[1.7,3000]].forEach(c=>this.note(ctx,dst,t0+c[0],c[1],"sine",.14,.22));
    return 3;
  },
  play(loss,opts){
    const ctx=Snd.ensure(); if(!ctx) return 0;
    this.stop(); const ch=this.chain(ctx,loss,!!(opts&&opts.robotic)), t0=ctx.currentTime+.05;
    const dur=(opts&&opts.source==="ambience")?this.ambience(ctx,ch.input,t0):this.melody(ctx,ch.input,t0);
